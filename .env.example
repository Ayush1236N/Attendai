# Copy this to .env in the project root before running `docker compose up`

# A long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_secret

# Comma-separated list of origins allowed to call the backend
# (your admin dashboard URL, your Expo dev URL, etc.)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Browser-facing URL the admin dashboard should call.
# - Local Docker on the same machine: http://localhost:5000/api
# - Accessing from another device on your LAN: http://<your-lan-ip>:5000/api
# - Deployed backend: https://your-backend-domain.com/api
VITE_API_URL=http://localhost:5000/api
