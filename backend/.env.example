# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/attendance_system

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# AI / Face Recognition Service
FACE_SERVICE_URL=http://127.0.0.1:8000
FACE_MATCH_THRESHOLD=0.80

# Uploads
UPLOAD_MAX_SIZE_MB=5

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.10:19000

# Used to build links inside password-reset emails. Point this at wherever
# the admin dashboard / employee reset-password page is hosted.
FRONTEND_URL=http://localhost:5173

# --- Outgoing email (forgot-password links, 2FA notices) ---
# If left blank, emails are printed to the server console instead of sent —
# useful for local development without a real mailbox. For Gmail, use an
# "app password" (not your normal password) with SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Attendai <no-reply@attendai.app>
PASSWORD_RESET_EXPIRY_MINUTES=30

# If true, every employee must finish 2FA setup — the app is told to prompt
# for it right after their first successful login.
EMPLOYEE_2FA_REQUIRED=true

# Timezone used for "today", late-arrival checks and hybrid office days.
# Hosts like Render run in UTC, so set this explicitly.
TIMEZONE=Asia/Kolkata

# --- Power BI / reporting feed (read-only) ---
# Long random secret. Leave empty to switch the /api/bi feed OFF.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORTING_API_KEY=
# Optional: Power BI streaming/push dataset URL for real-time tiles.
POWERBI_PUSH_URL=

# Hour (0-23, org timezone) after which the nightly reporting sync runs. 'off' disables.
WAREHOUSE_SYNC_HOUR=2

# --- Dashboard write-back (Power Apps / Power Automate) ---
# SEPARATE secret from REPORTING_API_KEY. Empty = write-back OFF.
REPORTING_WRITE_KEY=
WRITEBACK_MAX_AMOUNT=50000
WRITEBACK_MAX_HOURLY_RATE=5000
# Past months still editable from a dashboard (1 = this month and last month).
WRITEBACK_MONTHS_BACK=1
